+/* Enable the PMU cycle counter (PMCCNTR_EL0) on this CPU. */
+static void
+sweet_pmccntr_enable(void)
+{
+	uint64_t pmcr = __builtin_arm_rsr64("pmcr_el0");
+	pmcr |= PMCR_E | PMCR_C;
+	__builtin_arm_wsr64("pmcr_el0", pmcr);
+	__builtin_arm_wsr64("pmcntenset_el0", PMCNTENSET_CNTEN0);
+	__asm__ volatile("isb" ::: "memory");
+}
+
+/* Measure this CPU's clock in MHz by comparing PMCCNTR cycles vs CNTPCT over
+ * a fixed CNTPCT interval (~1 ms). Returns MHz, or -1 if PMCCNTR is trapped
+ * (reads don't advance). */
+static int
+sweet_measure_cpu_mhz(void)
+{
+	uint64_t cntfrq = __builtin_arm_rsr64("cntfrq_el0");
+	uint64_t start_cyc, end_cyc, start_cnt, end_cnt;
+
+	start_cyc = __builtin_arm_rsr64("pmccntr_el0");
+	start_cnt = __builtin_arm_rsr64("cntpct_el0");
+
+	/* Busy-wait for ~1 ms of CNTPCT ticks. */
+	uint64_t target = start_cnt + cntfrq / 1000;
+	while (__builtin_arm_rsr64("cntpct_el0") < target)
+		;
+
+	end_cyc = __builtin_arm_rsr64("pmccntr_el0");
+	end_cnt = __builtin_arm_rsr64("cntpct_el0");
+
+	if (end_cyc == start_cyc) {
+		return -1;	/* PMCCNTR not counting (trapped by secure monitor) */
+	}
+
+	uint64_t cyc_delta = end_cyc - start_cyc;
+	uint64_t cnt_delta = end_cnt - start_cnt;
+	/* MHz = (cycles / cnt_delta) * (cntfrq / 1e6) */
+	return (int)((cyc_delta * cntfrq) / (cnt_delta * 1000000ULL));
+}
