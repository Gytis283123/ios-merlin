diff --git a/b/iokit/Kernel/arm/SweetBootUI.cpp b/iokit/Kernel/arm/SweetBootUI.cpp
new file mode 100644
index 0000000..451a7cd
--- /dev/null
+++ b/iokit/Kernel/arm/SweetBootUI.cpp
@@ -0,0 +1,565 @@
+/*
+ * SweetBootUI - the iOS-style boot screen for the SWEET platform.
+ *
+ * The ABL/LK bootloader leaves a static splash in the continuous-splash
+ * framebuffer (0x7e39c458 on merlin).  Nothing in XNU or in the iOS
+ * userspace ever redraws that splash, so before this file the phone showed
+ * the bootloader picture (and whatever the text console painted over it)
+ * for the whole boot: the Apple mark was there, but the progress bar was a
+ * frozen part of the bootloader image and could never move.
+ *
+ * This is a real renderer, not an asset blit:
+ *   - the Apple mark is a vector outline (SweetBootLogo.h, generated from
+ *     tools/gen-boot-logo.py) rasterised at runtime with 4x4 supersampling
+ *     to whatever panel geometry the platform reports;
+ *   - the progress bar is drawn as a rounded track plus rounded fill whose
+ *     length comes from real boot milestones passed to
+ *     sweet_boot_ui_progress() (root mount, launchd, backboardd,
+ *     SpringBoard), never from a timer;
+ *   - it runs until the compositor presents a frame that actually contains
+ *     pixels (i.e. SpringBoard's UI), then it stops drawing so the real UI
+ *     owns the panel.
+ *
+ * Progress is monotonic and capped at 85% until a non-blank composited
+ * frame arrives; an unreachable milestone simply leaves the bar where it is
+ * instead of pretending the boot completed.
+ */
+#include "SweetBootUI.h"
+
+#if !defined(SWEET_BOOTUI_HOST_TEST)
+/* SWEET is defined by pexpert/arm64/SWEET.h (pulled in by board_config.h). */
+#include <pexpert/arm64/board_config.h>
+#endif
+
+#if defined(SWEET)
+
+#include "SweetBootLogo.h"
+
+#if defined(SWEET_BOOTUI_HOST_TEST)
+#include <stdlib.h>
+#include <string.h>
+#define BOOTUI_ALLOC(sz)        malloc(sz)
+#define BOOTUI_FREE(p, sz)      free(p)
+#define BOOTUI_PARSE_ARG(name, v) 0
+#define BOOTUI_LOCK_CREATE()    do {} while (0)
+#define BOOTUI_LOCK_READY()     (true)
+#define BOOTUI_LOCK()           do {} while (0)
+#define BOOTUI_UNLOCK()         do {} while (0)
+#else
+#include <IOKit/IOLib.h>
+#include <libkern/libkern.h>
+#include <kern/debug.h>
+#include <pexpert/pexpert.h>
+#define BOOTUI_ALLOC(sz)        IOMallocData(sz)
+#define BOOTUI_FREE(p, sz)      IOFreeData(p, sz)
+#define BOOTUI_PARSE_ARG(name, v) \
+	PE_parse_boot_argn(name, (v), sizeof(*(v)))
+
+/*
+ * BootUI state is touched from three unrelated execution contexts:
+ * AppleCLCD::start (IOKit thread), the vsync workloop (both
+ * sweet_boot_ui_redraw() from vsyncFired and
+ * sweet_boot_ui_frame_feedback() from present(), each running with no
+ * framebuffer lock held), and the bsd/exec threads that report
+ * milestones through sweet_boot_ui_progress().  Serialize all state,
+ * including the logo-mask lifetime, behind a sleepable IOLock: every
+ * one of those contexts may block, and the lock is a leaf (no other
+ * lock is taken while it is held).  Without it the frame_feedback
+ * free of bootui.mask can race a concurrent bootui_blit_logo() read
+ * of the same mask (use-after-free, 0120 review).
+ */
+static IOLock *bootui_lock;
+
+#define BOOTUI_LOCK_CREATE()    do { \
+	if (bootui_lock == NULL) { \
+		bootui_lock = IOLockAlloc(); \
+	} \
+} while (0)
+#define BOOTUI_LOCK_READY()     (bootui_lock != NULL)
+#define BOOTUI_LOCK()           do { \
+	if (bootui_lock != NULL) { \
+		IOLockLock(bootui_lock); \
+	} \
+} while (0)
+#define BOOTUI_UNLOCK()         do { \
+	if (bootui_lock != NULL) { \
+		IOLockUnlock(bootui_lock); \
+	} \
+} while (0)
+#endif
+
+#define BOOTUI_MAX_EDGES        512
+#define BOOTUI_MAX_XINGS        32
+#define BOOTUI_MAX_MASK_W       1024
+#define BOOTUI_MAX_MASK_H       1024
+
+struct sweet_bootui_state {
+	volatile uint32_t *fb;
+	uint32_t width;
+	uint32_t height;
+	uint32_t stride_px;
+
+	uint8_t *mask;                  /* logo coverage, 0..255 */
+	int mask_w;
+	int mask_h;
+	int logo_x;
+	int logo_y;
+
+	int bar_x;
+	int bar_y;
+	int bar_w;
+	int bar_h;
+	int bar_radius;
+
+	int progress;                   /* 0..100, monotonic */
+	int started;
+	int active;
+	int done;
+};
+
+static struct sweet_bootui_state bootui;
+
+/* ------------------------------------------------------------------ */
+/* fixed-point helpers (the kernel has no FP context here)             */
+
+static int
+bootui_isqrt(int v)
+{
+	int r = 0;
+	int bit = 1 << 30;
+
+	if (v <= 0) {
+		return 0;
+	}
+	while (bit > v) {
+		bit >>= 2;
+	}
+	while (bit != 0) {
+		if (v >= r + bit) {
+			v -= r + bit;
+			r = (r >> 1) + bit;
+		} else {
+			r >>= 1;
+		}
+		bit >>= 2;
+	}
+	return r;
+}
+
+/* ------------------------------------------------------------------ */
+/* logo rasteriser                                                     */
+
+struct bootui_edge {
+	int32_t x0, y0, x1, y1;         /* 16.16 mask pixel coordinates */
+	int dir;
+};
+
+static struct bootui_edge edges[BOOTUI_MAX_EDGES];
+static int edge_count;
+
+static void
+bootui_build_edges(int w, int h)
+{
+	edge_count = 0;
+	for (int c = 0; c < SWEET_BOOT_LOGO_CONTOURS; c++) {
+		int s = sweet_boot_logo_contour_start[c];
+		int e = sweet_boot_logo_contour_start[c + 1];
+		for (int i = s; i < e && edge_count < BOOTUI_MAX_EDGES; i++) {
+			int j = (i + 1 == e) ? s : i + 1;
+			/* p.x * w == (p.x/65536)*w in 16.16 */
+			int32_t x0 = (int32_t)((uint32_t)sweet_boot_logo_pts[i][0] * (uint32_t)w);
+			int32_t y0 = (int32_t)((uint32_t)sweet_boot_logo_pts[i][1] * (uint32_t)h);
+			int32_t x1 = (int32_t)((uint32_t)sweet_boot_logo_pts[j][0] * (uint32_t)w);
+			int32_t y1 = (int32_t)((uint32_t)sweet_boot_logo_pts[j][1] * (uint32_t)h);
+			if (y0 == y1) {
+				continue;
+			}
+			struct bootui_edge *ed = &edges[edge_count++];
+			ed->x0 = x0;
+			ed->y0 = y0;
+			ed->x1 = x1;
+			ed->y1 = y1;
+			ed->dir = (y1 > y0) ? 1 : -1;
+		}
+	}
+}
+
+/*
+ * Even-odd scanline fill with 4 vertical sub-scanlines and 4 horizontal
+ * sub-samples per pixel.  Each mask pixel ends up with a 0..255 coverage.
+ */
+static void
+bootui_rasterize_mask(void)
+{
+	int w = bootui.mask_w;
+	int h = bootui.mask_h;
+	uint8_t *mask = bootui.mask;
+	int32_t xing[BOOTUI_MAX_XINGS];
+
+	if (mask == NULL || w <= 0 || h <= 0) {
+		return;
+	}
+	memset(mask, 0, (size_t)w * (size_t)h);
+	bootui_build_edges(w, h);
+
+	for (int py = 0; py < h; py++) {
+		uint8_t acc[BOOTUI_MAX_MASK_W];
+		if (w > BOOTUI_MAX_MASK_W) {
+			return;
+		}
+		memset(acc, 0, (size_t)w);
+
+		for (int sub = 0; sub < 4; sub++) {
+			/* sample line in 16.16 mask pixels */
+			int32_t sy = (py << 16) + ((sub << 16) + 0x2000) / 4;
+			int n = 0;
+
+			for (int e = 0; e < edge_count; e++) {
+				struct bootui_edge *ed = &edges[e];
+				int32_t ytop = ed->y0 < ed->y1 ? ed->y0 : ed->y1;
+				int32_t ybot = ed->y0 < ed->y1 ? ed->y1 : ed->y0;
+				if (sy < ytop || sy >= ybot) {
+					continue;
+				}
+				{
+					int64_t num = (int64_t)(sy - ed->y0) *
+					    (int64_t)(ed->x1 - ed->x0);
+					int64_t den = (int64_t)(ed->y1 - ed->y0);
+					int32_t x = ed->x0 + (int32_t)(num / den);
+					if (n < BOOTUI_MAX_XINGS) {
+						xing[n++] = x;
+					}
+				}
+			}
+			for (int a = 1; a < n; a++) {
+				int32_t v = xing[a];
+				int b = a - 1;
+				while (b >= 0 && xing[b] > v) {
+					xing[b + 1] = xing[b];
+					b--;
+				}
+				xing[b + 1] = v;
+			}
+			for (int x = 0; x < w; x++) {
+				int cov = 0;
+				for (int k = 0; k < 4; k++) {
+					int32_t sx = (x << 16) + ((k << 16) + 0x2000) / 4;
+					int inside = 0;
+					for (int a = 0; a + 1 < n; a += 2) {
+						if (sx >= xing[a] && sx < xing[a + 1]) {
+							inside = 1;
+							break;
+						}
+					}
+					cov += inside;
+				}
+				acc[x] = (uint8_t)(acc[x] + cov);
+			}
+		}
+		for (int x = 0; x < w; x++) {
+			mask[(size_t)py * w + x] = (uint8_t)((acc[x] * 255) / 16);
+		}
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* panel drawing                                                       */
+
+static inline void
+bootui_put(int x, int y, uint32_t argb)
+{
+	if (x < 0 || y < 0 || x >= (int)bootui.width || y >= (int)bootui.height) {
+		return;
+	}
+	bootui.fb[(size_t)y * bootui.stride_px + x] = argb;
+}
+
+static void
+bootui_blit_logo(void)
+{
+	int w = bootui.mask_w;
+	int h = bootui.mask_h;
+	uint8_t *mask = bootui.mask;
+
+	if (mask == NULL) {
+		return;
+	}
+	for (int y = 0; y < h; y++) {
+		uint32_t *dst = (uint32_t *)bootui.fb +
+		    (size_t)(bootui.logo_y + y) * bootui.stride_px + bootui.logo_x;
+		const uint8_t *src = mask + (size_t)y * w;
+		for (int x = 0; x < w; x++) {
+			uint32_t a = src[x];
+			uint32_t bg, r, g, b;
+			if (a == 0) {
+				continue;
+			}
+			if (a >= 255) {
+				dst[x] = 0xffffffffu;
+				continue;
+			}
+			bg = dst[x];
+			r = (((bg >> 16) & 0xff) * (255 - a) + 255 * a) / 255;
+			g = (((bg >> 8) & 0xff) * (255 - a) + 255 * a) / 255;
+			b = ((bg & 0xff) * (255 - a) + 255 * a) / 255;
+			dst[x] = 0xff000000u | (r << 16) | (g << 8) | b;
+		}
+	}
+}
+
+/* Horizontal inset of a filled rounded rectangle for row y. */
+static int
+bootui_round_inset(int y, int h, int r)
+{
+	int dy = y - (h - 1) / 2;
+	int rr;
+	int v;
+
+	if (r <= 0) {
+		return 0;
+	}
+	if (dy < 0) {
+		dy = -dy;
+	}
+	rr = r * r - dy * dy;
+	if (rr <= 0) {
+		return r;
+	}
+	v = r - bootui_isqrt(rr);
+	return v < 0 ? 0 : v;
+}
+
+static void
+bootui_draw_bar(void)
+{
+	const uint32_t track = 0xff333333u;
+	const uint32_t fill = 0xffffffffu;
+	int filled;
+
+	if (bootui.bar_w <= 0 || bootui.bar_h <= 0) {
+		return;
+	}
+	filled = (bootui.progress * bootui.bar_w + 50) / 100;
+	if (filled < 0) {
+		filled = 0;
+	}
+	if (filled > bootui.bar_w) {
+		filled = bootui.bar_w;
+	}
+	for (int y = 0; y < bootui.bar_h; y++) {
+		int inset = bootui_round_inset(y, bootui.bar_h, bootui.bar_radius);
+		int left = bootui.bar_x + inset;
+		int right = bootui.bar_x + bootui.bar_w - inset;
+		for (int x = left; x < right; x++) {
+			bootui_put(x, bootui.bar_y + y, track);
+		}
+		if (filled > inset) {
+			for (int x = left; x < bootui.bar_x + filled; x++) {
+				bootui_put(x, bootui.bar_y + y, fill);
+			}
+		}
+	}
+}
+
+static void
+bootui_redraw_locked(void)      /* call with bootui_lock held */
+{
+	if (!bootui.started || !bootui.active || bootui.done) {
+		return;
+	}
+#if !defined(SWEET_BOOTUI_HOST_TEST)
+	if (panic_active()) {
+		return;         /* never paint over a panic */
+	}
+#endif
+	bootui_blit_logo();
+	bootui_draw_bar();
+}
+
+void
+sweet_boot_ui_redraw(void)
+{
+	if (!BOOTUI_LOCK_READY()) {
+		return;         /* sweet_boot_ui_start() not called yet */
+	}
+	BOOTUI_LOCK();
+	bootui_redraw_locked();
+	BOOTUI_UNLOCK();
+}
+
+/* ------------------------------------------------------------------ */
+/* public API                                                          */
+
+void
+sweet_boot_ui_start(uintptr_t pixels, uint32_t width, uint32_t height,
+    uint32_t row_bytes)
+{
+	int logo_h, logo_w;
+	int bar_h;
+	int disable = 0;
+
+	if (BOOTUI_PARSE_ARG("sweetbootui", &disable) && disable == 0) {
+		return;                 /* boot-arg opt-out */
+	}
+	if (pixels == 0 || width < 200 || height < 200 ||
+	    row_bytes < width * 4) {
+		return;
+	}
+	BOOTUI_LOCK_CREATE();
+	if (!BOOTUI_LOCK_READY()) {
+		return;         /* refuse to run unsynchronized */
+	}
+	BOOTUI_LOCK();
+	if (bootui.started) {
+		BOOTUI_UNLOCK();
+		return;
+	}
+	bootui.fb = (volatile uint32_t *)pixels;
+	bootui.width = width;
+	bootui.height = height;
+	bootui.stride_px = row_bytes / 4;
+
+	/* iPhone X proportions: mark centred at 44% of the panel height,
+	 * bar centred at 52%, mark height 15% of the panel. */
+	logo_h = (int)(((uint64_t)height * 14) / 100);
+	logo_w = (int)(((uint64_t)logo_h * 384) / 512);
+	if (logo_h > BOOTUI_MAX_MASK_H) {
+		logo_h = BOOTUI_MAX_MASK_H;
+	}
+	if (logo_w > BOOTUI_MAX_MASK_W) {
+		logo_w = BOOTUI_MAX_MASK_W;
+	}
+	if (logo_h < 8 || logo_w < 8) {
+		BOOTUI_UNLOCK();
+		return;
+	}
+	bootui.mask_w = logo_w;
+	bootui.mask_h = logo_h;
+	bootui.logo_x = ((int)width - logo_w) / 2;
+	bootui.logo_y = (int)(((uint64_t)height * 42) / 100) - logo_h / 2;
+
+	bar_h = (int)height / 280;
+	if (bar_h < 6) {
+		bar_h = 6;
+	}
+	if (bar_h > 16) {
+		bar_h = 16;
+	}
+	bootui.bar_h = bar_h;
+	bootui.bar_radius = bar_h / 2;
+	bootui.bar_w = (int)(((uint64_t)width * 62) / 100);
+	bootui.bar_x = ((int)width - bootui.bar_w) / 2;
+	bootui.bar_y = (int)(((uint64_t)height * 53) / 100) - bar_h / 2;
+
+	bootui.mask = (uint8_t *)BOOTUI_ALLOC((size_t)logo_w * (size_t)logo_h);
+	if (bootui.mask == NULL) {
+		BOOTUI_UNLOCK();
+		return;
+	}
+	bootui.started = 1;
+	bootui.active = 1;
+	bootui.progress = 5;            /* framebuffer is up */
+	bootui_rasterize_mask();
+
+	/* Start from the iPhone's black boot background: the bootloader splash
+	 * and any console text already on the panel are not ours to keep. */
+	for (uint32_t y = 0; y < bootui.height; y++) {
+		volatile uint32_t *row = bootui.fb + (size_t)y * bootui.stride_px;
+		for (uint32_t x = 0; x < bootui.width; x++) {
+			row[x] = 0xff000000u;
+		}
+	}
+
+#if !defined(SWEET_BOOTUI_HOST_TEST)
+	{
+		/* Keep the text console from fighting the boot screen; it still
+		 * reaches the persistent log (serial_console.c, 0067). */
+		extern int sweet_console_muted;
+		int keep_console = 0;
+		if (!BOOTUI_PARSE_ARG("sweetbootui_noconsole", &keep_console) ||
+		    keep_console == 0) {
+			sweet_console_muted = 1;
+		}
+	}
+#endif
+	bootui_redraw_locked();
+	BOOTUI_UNLOCK();
+}
+
+void
+sweet_boot_ui_progress(int percent)
+{
+	if (percent < 0) {
+		return;
+	}
+	if (!BOOTUI_LOCK_READY()) {
+		return;
+	}
+	BOOTUI_LOCK();
+	if (percent > 85) {
+		percent = 85;           /* 100% only from a real UI frame */
+	}
+	if (percent > bootui.progress) {
+		bootui.progress = percent;
+		bootui_redraw_locked();
+	}
+	BOOTUI_UNLOCK();
+}
+
+void
+sweet_boot_ui_frame_feedback(uint32_t nonblank_samples)
+{
+	if (!BOOTUI_LOCK_READY()) {
+		return;
+	}
+	BOOTUI_LOCK();
+	if (!bootui.started || bootui.done) {
+		BOOTUI_UNLOCK();
+		return;
+	}
+	if (nonblank_samples >= 8) {
+		/* The compositor has real content: SpringBoard owns the screen. */
+		bootui.active = 0;
+		bootui.done = 1;
+		bootui.progress = 100;
+		if (bootui.mask != NULL) {
+			/* Free the mask under the same lock the blit holds, so a
+			 * redraw running on another CPU can never read freed
+			 * memory (0120 review: unsynchronized free vs. blit). */
+			BOOTUI_FREE(bootui.mask,
+			    (size_t)bootui.mask_w * (size_t)bootui.mask_h);
+			bootui.mask = NULL;
+		}
+	}
+	BOOTUI_UNLOCK();
+}
+
+bool
+sweet_boot_ui_active(void)
+{
+	bool active;
+
+	if (!BOOTUI_LOCK_READY()) {
+		return false;
+	}
+	BOOTUI_LOCK();
+	active = bootui.started && bootui.active && !bootui.done;
+	BOOTUI_UNLOCK();
+	return active;
+}
+
+int
+sweet_boot_ui_progress_value(void)
+{
+	int progress;
+
+	if (!BOOTUI_LOCK_READY()) {
+		return 0;
+	}
+	BOOTUI_LOCK();
+	progress = bootui.progress;
+	BOOTUI_UNLOCK();
+	return progress;
+}
+
+#endif /* SWEET */
