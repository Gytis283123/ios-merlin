+#endif
+
+/* Begin drawing on the panel framebuffer.  No-op when already started or
+ * when the boot-arg sweetbootui=0 is present. */
+void sweet_boot_ui_start(uintptr_t pixels, uint32_t width, uint32_t height,
+    uint32_t row_bytes);
+
+/* Report a real boot milestone, 0..100.  Monotonic; values above 85 are
+ * clamped until a real composited frame is seen. */
+void sweet_boot_ui_progress(int percent);
+
+/* Repaint the mark and bar (called from the display vsync, after the
+ * compositor's layer copy, so the boot screen stays on top).  All
+ * entry points in this header serialize internally (a dedicated
+ * IOLock in the kernel implementation) and are safe to call from
+ * any thread. */
+void sweet_boot_ui_redraw(void);
+
+/* Number of non-blank samples in a freshly presented layer.  When the
+ * compositor starts producing real pixels the boot screen stops drawing. */
+void sweet_boot_ui_frame_feedback(uint32_t nonblank_samples);
+
+bool sweet_boot_ui_active(void);
+int sweet_boot_ui_progress_value(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _IOKIT_SWEETBOOTUI_H_ */
