+static bool
+sweet_scaler_query(OSDictionary *dict)
+{
+	OSString *provider = OSDynamicCast(OSString,
+	    dict->getObject("IOProviderClass"));
+	return provider != NULL &&
+	    provider->isEqualTo("AppleM2ScalerCSCDriver");
+}
+
+static void
+sweet_scaler_copy_service(IOService *service,
+    struct sweet_scaler_service_info *info)
+{
+	bzero(info, sizeof(*info));
+	if (service == NULL) {
+		return;
+	}
+	strlcpy(info->service_class, service->getMetaClass()->getClassName(),
+	    sizeof(info->service_class));
+	const char *service_name = service->getName();
+	strlcpy(info->service_name, service_name != NULL ? service_name : "?",
+	    sizeof(info->service_name));
+	IORegistryEntry *parent = service->getParentEntry(gIOServicePlane);
+	if (parent != NULL) {
+		strlcpy(info->parent_class, parent->getMetaClass()->getClassName(),
+		    sizeof(info->parent_class));
+		const char *parent_name = parent->getName();
+		strlcpy(info->parent_name, parent_name != NULL ? parent_name : "?",
+		    sizeof(info->parent_name));
+	}
+}
+
+static void
+sweet_scaler_event(unsigned int kind, const char *caller,
+    OSDictionary *dict, const char *state, unsigned int total_services,
+    const struct sweet_scaler_service_info *services,
+    unsigned int stored_services)
+{
+	struct sweet_scaler_stats snapshot;
+	uint64_t now_ns = 0;
+	bool emit = false;
+	char event[16] = "summary";
+	char state_copy[sizeof(sweet_scaler_stats[0].last_state)];
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+	strlcpy(state_copy, state, sizeof(state_copy));
+	lck_mtx_lock(&sweet_scaler_lock);
+	struct sweet_scaler_stats *stats = &sweet_scaler_stats[kind];
+	if (stats->count == 0) {
+		stats->first_ns = now_ns;
+		strlcpy(event, "first", sizeof(event));
+		emit = true;
+	} else if (strcmp(stats->last_state, state_copy) != 0) {
+		strlcpy(event, "state-change", sizeof(event));
+		emit = true;
+	} else if (now_ns - stats->last_report_ns >= SWEET_SCALER_SUMMARY_NS) {
+		emit = true;
+	}
+	stats->count++;
+	stats->last_ns = now_ns;
+	strlcpy(stats->last_state, state_copy, sizeof(stats->last_state));
+	if (emit) {
+		stats->last_report_ns = now_ns;
+		snapshot = *stats;
+	}
+	lck_mtx_unlock(&sweet_scaler_lock);
+	if (!emit) {
+		return;
+	}
+
+	OSSerialize *ser = OSSerialize::withCapacity(4096);
+	bool serialized = ser != NULL && dict != NULL && dict->serialize(ser);
+	const char *text = serialized ? ser->text() :
+	    "dictionary-serialization-failed";
+	IOLog("SWEET SCALER: %s t=%llu.%03llu kind=%s caller=%s "
+	    "state=%s lookups=%llu first=%llu.%03llu last=%llu.%03llu "
+	    "services=%u shown=%u matching=%s\n",
+	    event, (unsigned long long)(now_ns / 1000000000ull),
+	    (unsigned long long)((now_ns / 1000000ull) % 1000),
+	    kind == 0 ? "iterator" : "single", caller, snapshot.last_state,
+	    (unsigned long long)snapshot.count,
+	    (unsigned long long)(snapshot.first_ns / 1000000000ull),
+	    (unsigned long long)((snapshot.first_ns / 1000000ull) % 1000),
+	    (unsigned long long)(snapshot.last_ns / 1000000000ull),
+	    (unsigned long long)((snapshot.last_ns / 1000000ull) % 1000),
+	    total_services, stored_services, text);
+	for (unsigned int i = 0; i < stored_services; i++) {
+		IOLog("SWEET SCALER: service[%u] class=%s name=%s "
+		    "parent_class=%s parent_name=%s\n", i,
+		    services[i].service_class, services[i].service_name,
+		    services[i].parent_class, services[i].parent_name);
+	}
+	OSSafeReleaseNULL(ser);
+}
